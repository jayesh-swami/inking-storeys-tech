         its own staggered delay - see letter-pop-in below. -->
    <g id="word-storeys" fill="#ffffff">
      <use id="storeys-0" xlink:href="#glyph-0-0" x="87.700404" y="305.026895"/>
      <use id="storeys-1" xlink:href="#glyph-0-1" x="99.151912" y="305.026895"/>
      <use id="storeys-2" xlink:href="#glyph-0-2" x="109.27119" y="305.026895"/>
      <use id="storeys-3" xlink:href="#glyph-0-3" x="123.089531" y="305.026895"/>
      <use id="storeys-4" xlink:href="#glyph-0-4" x="132.953702" y="305.026895"/>
      <use id="storeys-5" xlink:href="#glyph-0-5" x="146.247655" y="305.026895"/>
      <use id="storeys-6" xlink:href="#glyph-0-0" x="158.492831" y="305.026895"/>
    </g>
    </g>
  </svg>
</div>

<style>
  #logo-icon path {
    fill: none;
    stroke: #ffffff;
    /* Bigger than the wordmark strokes' stroke-width (3) because this
       path lives in `icon.svg`'s own much larger native coordinate
       space (0-395/0-699, vs. the wordmark's ~180-wide space) - it
       gets scaled back down by #logo-icon's transform along with
       everything else. */
    stroke-width: 130;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: var(--stroke-length, 3000);
    stroke-dashoffset: var(--stroke-length, 3000);
    opacity: 0;
  }

  #word-inking path {
    fill: none;
    stroke: #ffffff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: var(--stroke-length, 1000);
    stroke-dashoffset: var(--stroke-length, 1000);
    opacity: 0;
  }

  #word-storeys use {
    opacity: 0;
    transform: translateY(4px);
    transform-box: fill-box;
    transform-origin: center;
  }

  /*
   * `--fly-x`/`--fly-y`/`--fly-scale` are set by the script below, from
   * measuring where #logo-icon actually sits vs. its counterpart in
   * Nav.astro. `transform-origin: 0 0` (top-left, matching how
   * getBoundingClientRect reports position) keeps the translate/scale
   * math in the script simple: scaling anchors at the top-left corner,
   * so animating to `translate(dx, dy) scale(s)` - where dx/dy is just
   * the delta between the two rects' top-left corners - lands this
   * group's top-left exactly on the Nav element's top-left, no extra
   * centering correction needed.
   */
  #logo-icon {
    transform-box: fill-box;
    transform-origin: 0 0;
  }

  @keyframes ink-stroke-draw {
    /*
     * Every property below is repeated at all three stops on purpose:
     * a CSS keyframe that omits a property doesn't mean "unchanged
     * since the last stop" - if a property is only ever declared at
     * one stop, its value is held constant for the *whole* animation,
     * not just from that point on. `stroke` only being declared at
     * `100%` (its intended end state) previously meant `stroke: none`
     * applied for the entire draw phase too, not just the end - so
     * nothing was ever visible until each stroke's very last instant,
     * which read as strokes "disappearing" right after being drawn.
     */
    0% {
      opacity: 1;
      fill: none;
      stroke: #ffffff;
      stroke-dashoffset: var(--stroke-length, 1000);
    }
    65% {
      opacity: 1;
      fill: none;
      stroke: #ffffff;
      stroke-dashoffset: 0;
    }
    100% {
      opacity: 1;
      fill: #ffffff;
      stroke: #ffffff;
      stroke-dashoffset: 0;
    }
  }

  @keyframes letter-pop-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes logo-fly {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(var(--fly-x, 0px), var(--fly-y, 0px)) scale(var(--fly-scale, 1));
    }
  }

  @keyframes wordmark-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes preloader-backdrop-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  /*
   * Timeline (only runs once the JS below adds the `.run` class - see
   * "why gate this behind JS?" note in the script):
   *   0.0s - 0.85s  the icon mark draws on (ring, then the "S" body)
   *   0.85s - 2.80s the 7 "inking" strokes draw in one at a time, 0.24s
   *                 apart (last two - the 2nd i's dot and "g" - given a
   *                 bit more room since they read as separate beats)
   *   2.70s - 3.60s "storeys"'s 7 letters pop in, 0.1s apart, starting
   *                 just before the last ink stroke finishes so the two
   *                 words flow together rather than pausing between them
   *   3.60s - 4.00s hold, fully written
   *   4.00s - 4.75s icon flies from its splash position to exactly
   *                 where it sits in Nav.astro (see logo-fly); the
   *                 wordmark has nowhere to fly to (Nav is icon-only),
   *                 so it fades out instead (wordmark-fade-out, 4.00s -
   *                 4.50s) rather than hanging in place
   *   4.10s - 4.80s backdrop dissolves (starts just after the fly
   *                 begins, so the page doesn't show through before the
   *                 icon starts moving; ends just after the fly lands,
   *                 so nothing's visible behind the mark mid-flight)
   */
  #preloader.run #icon-path {
    animation: ink-stroke-draw 0.85s ease-out 0s forwards;
  }

  #preloader.run #word-inking path:nth-child(1) {
    animation: ink-stroke-draw 0.4s ease-out 0.85s forwards;
  }
  #preloader.run #word-inking path:nth-child(2) {
    animation: ink-stroke-draw 0.4s ease-out 1.09s forwards;
  }
  #preloader.run #word-inking path:nth-child(3) {
    animation: ink-stroke-draw 0.4s ease-out 1.33s forwards;
  }
  #preloader.run #word-inking path:nth-child(4) {
    animation: ink-stroke-draw 0.45s ease-out 1.57s forwards;
  }
  #preloader.run #word-inking path:nth-child(5) {
    animation: ink-stroke-draw 0.5s ease-out 1.85s forwards;
  }
  #preloader.run #word-inking path:nth-child(6) {
    animation: ink-stroke-draw 0.35s ease-out 2.2s forwards;
  }
  #preloader.run #word-inking path:nth-child(7) {
    animation: ink-stroke-draw 0.4s ease-out 2.4s forwards;
  }

  #preloader.run #word-storeys use:nth-child(1) {
    animation: letter-pop-in 0.3s ease-out 2.7s forwards;
  }
  #preloader.run #word-storeys use:nth-child(2) {
    animation: letter-pop-in 0.3s ease-out 2.8s forwards;
  }
  #preloader.run #word-storeys use:nth-child(3) {
    animation: letter-pop-in 0.3s ease-out 2.9s forwards;
  }
  #preloader.run #word-storeys use:nth-child(4) {
    animation: letter-pop-in 0.3s ease-out 3.0s forwards;
  }
  #preloader.run #word-storeys use:nth-child(5) {
    animation: letter-pop-in 0.3s ease-out 3.1s forwards;
  }
  #preloader.run #word-storeys use:nth-child(6) {
    animation: letter-pop-in 0.3s ease-out 3.2s forwards;
  }
  #preloader.run #word-storeys use:nth-child(7) {
    animation: letter-pop-in 0.3s ease-out 3.3s forwards;
  }

  #preloader.run #logo-icon {
    animation: logo-fly 0.75s cubic-bezier(0.65, 0, 0.35, 1) 4s forwards;
  }
  /* Nav no longer shows the wordmark (icon-only now), so there's
     nowhere for this half of the mark to fly to - it fades out instead
     of hanging motionless in the middle of the screen while the icon
     flies off and the backdrop dissolves around it. */
  #preloader.run #logo-wordmark {
    animation: wordmark-fade-out 0.5s ease-in 4s forwards;
  }

  #preloader.run #preloader-backdrop {
    animation: preloader-backdrop-out 0.7s ease-in 4.1s forwards;
  }
</style>

<script>
  function runPreloader() {
    const el = document.getElementById("preloader");
    if (!el) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (sessionStorage.getItem("inking-storeys-preloaded") || reduceMotion) {
      // Already shown this session, or the visitor asked for reduced
      // motion - skip straight to removing it, no animation.
      el.remove();
      return;
    }

    sessionStorage.setItem("inking-storeys-preloaded", "1");
    document.documentElement.style.overflow = "hidden";

    // The icon and each "inking" stroke draw on via stroke-dasharray/
    // dashoffset, which needs each path's actual rendered length -
    // there's no CSS-only way to get this (unlike a fixed-length font
    // glyph), so it's measured here per-path and exposed to the CSS
    // keyframes (ink-stroke-draw, above) as a custom property.
    el.querySelectorAll<SVGPathElement>("#logo-icon path, #word-inking path").forEach((path) => {
      path.style.setProperty("--stroke-length", String(path.getTotalLength()));
    });

    // Sets up the "fly to nav" transform (logo-fly, above): measures
    // where the source group currently sits vs. where its counterpart
    // already sits in Nav.astro (rendered underneath the opaque
    // backdrop this whole time, at its real final position/size for
    // the current viewport - nothing about Nav changes once the page
    // has loaded, so there's no need to re-measure right before the fly
    // actually starts). `transform-origin: 0 0` on #logo-icon (see the
    // <style> block) means this only needs the top-left corners' delta
    // and a single width-based scale ratio, not any centering math. Nav
    // is icon-only now, so this is only called for #logo-icon -
    // #logo-wordmark fades out instead (wordmark-fade-out, above).
    function setFlyTarget(source: Element | null, targetId: string) {
      const target = document.getElementById(targetId);
      if (!source || !target) return;
      const from = source.getBoundingClientRect();
      const to = target.getBoundingClientRect();
      const scale = to.width / from.width;
      (source as SVGElement).style.setProperty("--fly-x", `${to.left - from.left}px`);
      (source as SVGElement).style.setProperty("--fly-y", `${to.top - from.top}px`);
      (source as SVGElement).style.setProperty("--fly-scale", String(scale));
    }

    setFlyTarget(el.querySelector("#logo-icon"), "nav-icon");

    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      document.documentElement.style.overflow = "";
      el.remove();
    };

    el.addEventListener("animationend", (event) => {
      // #preloader has multiple animations running on descendants (see
      // the <style> block); only react to the backdrop's fade-out,
      // which is timed to be the last one to finish (see the timeline
      // comment above) and the one that actually needs cleanup.
      if (event.animationName === "preloader-backdrop-out") finish();
    });

    // Safety net: guarantee cleanup even if the animation is interrupted
    // (backgrounded tab, dropped frames) and its end event never fires.
    setTimeout(finish, 5600);

    // Why gate the CSS animation behind adding this class instead of
    // letting it run unconditionally the moment the element paints?
    // Two reasons: (1) it lets the sessionStorage/reduced-motion checks
    // above skip the animation entirely rather than racing to remove
    // the element mid-animation, and (2) on client-side navigations
    // (Astro's View Transitions router), a fresh #preloader element
    // mounts on every route change - without this gate it would replay
    // the intro animation on every internal link click, not just the
    // first visit.
    el.classList.add("run");
  }

  runPreloader();
</script>
