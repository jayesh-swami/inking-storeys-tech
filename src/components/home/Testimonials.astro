---
import { getCollection } from "astro:content";
import { ChevronLeft, ChevronRight, Quote } from "@lucide/astro";

const testimonials = (await getCollection("testimonials")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="bg-terracotta px-6 py-24 text-alabaster md:px-10 md:py-32">
  <div class="mx-auto max-w-4xl text-center" data-carousel data-carousel-autoplay="7000">
    <Quote class="mx-auto mb-8 h-8 w-8 text-white" data-reveal />

    <div class="relative">
      {testimonials.map((t, i) => (
        <div
          data-carousel-slide
          class:list={["transition-opacity duration-700", i === 0 ? "opacity-100" : "pointer-events-none absolute inset-0 opacity-0"]}
        >
          <p class="font-serif text-2xl leading-snug md:text-4xl">
            &ldquo;{t.data.quote}&rdquo;
          </p>
          <p class="font-nav mt-8 text-xs uppercase tracking-widest text-alabaster/60">
            {t.data.author}
            {t.data.role && <span class="text-alabaster/35"> — {t.data.role}</span>}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-12 flex items-center justify-center gap-4">
      <button type="button" data-carousel-prev aria-label="Previous testimonial" class="rounded-full border border-alabaster/25 p-2 transition-colors hover:border-white hover:text-white">
        <ChevronLeft class="h-4 w-4" />
      </button>
      <div class="flex items-center gap-1.5" data-carousel-dots></div>
      <button type="button" data-carousel-next aria-label="Next testimonial" class="rounded-full border border-alabaster/25 p-2 transition-colors hover:border-white hover:text-white">
        <ChevronRight class="h-4 w-4" />
      </button>
    </div>
  </div>
</section>
