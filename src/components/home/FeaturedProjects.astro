---
/**
 * Homepage's curated project grid: up to 4 projects flagged
 * `is_featured_on_home: true` in their frontmatter (see
 * src/content.config.ts). Ongoing projects (no completion_date yet)
 * lead the grid; Completed ones follow, most recently completed
 * first. Renders an
 * asymmetric magazine-style layout via `spanClasses` below (index 0
 * gets a large 2-row hero slot, 1-2 sit alongside it, 3 spans full
 * width beneath) - if more or fewer than 4 projects are ever featured,
 * anything past `spanClasses[3]` falls back to an even 2-column split.
 *
 * Each card layers three things on top of each other, innermost first:
 * the actual image (parallax-driven, via `data-parallax-speed`), an
 * oversized "frame" div around it that also carries the hover-zoom
 * effect, and an outer fixed-size "window" div that clips both. See
 * the inline comments below for why hover-zoom and parallax had to be
 * split onto separate elements instead of both living on the image.
 */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import SectionHeading from "../SectionHeading.astro";
import { withBase } from "../../lib/url";

const allFeatured = await getCollection("projects", ({ data }) => data.is_featured_on_home);
const projects = allFeatured
  .sort((a, b) => {
    if (a.data.status !== b.data.status) return a.data.status === "Ongoing" ? -1 : 1;
    // Both Ongoing: no completion_date to compare, so leave their relative order as-is.
    if (a.data.status === "Ongoing") return 0;
    return b.data.completion_date!.valueOf() - a.data.completion_date!.valueOf();
  })
  .slice(0, 4);

/** Grid placement per card index, matched positionally - see the layout note above. */
const spanClasses = [
  "md:col-span-4 md:row-span-2",
  "md:col-span-2",
  "md:col-span-2",
  "md:col-span-4",
];
---

<section class="px-6 py-24 md:px-10 md:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <SectionHeading eyebrow="Selected Work" heading="Featured Projects" headingClass="max-w-xl" />
      <a href={withBase("/projects")} class="font-nav group flex items-center gap-2 text-xs uppercase tracking-widest text-charcoal" data-reveal>
        View all projects
        <ArrowUpRight class="h-4 w-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
      </a>
    </div>

    <!--
      `md:auto-rows-[300px]` is load-bearing, not just a spacing choice:
      without an explicit row height, each card's `md:h-full` has
      nothing definite to resolve against once the image moved out of
      normal flow (see the parallax frame below), and every row
      collapsed to ~0px. It used to "work" only because the <img>'s own
      width/height attributes were accidentally propping the row open
      as a fallback - fragile, and broken the moment the image became
      an absolutely-positioned parallax child instead of a normal-flow one.
    -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-6 md:auto-rows-[300px]">
      {projects.map((project, i) => (
        <a
          href={withBase(`/projects/${project.data.slug}`)}
          class:list={["group relative block overflow-hidden bg-sand", spanClasses[i] ?? "md:col-span-3"]}
        >
          <!-- Outer: the fixed-size visible window (per the grid cell). -->
          <div class="relative aspect-[4/5] w-full overflow-hidden md:aspect-auto md:h-full">
            <!--
              Middle: the oversized (-m-32) parallax frame, which is also
              where the hover-zoom transform lives. It has to live here
              rather than on the <Image> itself: motion.ts sets the
              image's `transform` directly via JS every frame while it's
              in view, which would fight with (and get silently
              overwritten by) a CSS `group-hover:scale-105` on that same
              element. Putting the hover-zoom on this wrapper instead
              means it animates via the separate `scale` CSS property
              Tailwind v4 uses for scale utilities - independent of the
              image's own `transform`, so both effects coexist cleanly.
            -->
            <div class="absolute inset-0 -m-32 overflow-hidden transition-transform duration-700 ease-out group-hover:scale-105">
              <!--
                `hero_media.url` is a `string | ImageMetadata` union
                (see content.config.ts) - real project photos resolve
                to an imported ImageMetadata via the `image()` schema
                helper, while the placeholder Unsplash entries stay
                plain remote URL strings. <Image>'s `src` prop is a
                discriminated union (LocalImageProps | RemoteImageProps)
                rather than accepting that union directly, so this has
                to branch on `typeof` to let TypeScript narrow it to
                whichever branch actually applies per project.
              -->
              <!--
                No `height` here (deliberately, was `height={1500}`
                against a fixed `width={1200}` before, forcing every
                photo into the same portrait 4:5 crop at *build* time
                regardless of the card's actual shape) - card shapes
                vary a lot here (portrait on mobile, but the hero slot
                is `col-span-4 row-span-2`, wide on desktop), so a
                fixed portrait pre-crop meant the wide slot was
                cropping the *sides* off an image that was already
                cropped down to a narrow strip, compounding into a
                much tighter/more-zoomed result than either crop step
                alone. `inferSize` (+ only `width` capping the output
                resolution) keeps the encoded image at its natural
                aspect ratio instead, so `object-cover` below does the
                only crop, sized correctly for whichever card it's
                actually in.
              -->
              {typeof project.data.hero_media.url === "string" ? (
                <Image
                  src={project.data.hero_media.url}
                  alt={project.data.hero_media.alt}
                  inferSize
                  width={1200}
                  quality={65}
                  format="webp"
                  class="h-full w-full object-cover will-change-transform"
                  data-parallax-speed="0.7"
                  loading="lazy"
                />
              ) : (
                <Image
                  src={project.data.hero_media.url}
                  alt={project.data.hero_media.alt}
                  width={1200}
                  quality={65}
                  format="webp"
                  class="h-full w-full object-cover will-change-transform"
                  data-parallax-speed="0.7"
                  loading="lazy"
                />
              )}
            </div>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-terracotta/70 via-terracotta/0 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-6 text-alabaster">
            <p class="font-nav text-[11px] uppercase tracking-[0.2em] text-alabaster/70">
              {project.data.discipline} · {project.data.location}
              {project.data.status === "Ongoing" && <span class="text-terracotta-light"> · Ongoing</span>}
            </p>
            <h3 class="mt-2 font-serif text-2xl md:text-3xl">{project.data.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
